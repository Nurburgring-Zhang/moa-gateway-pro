# ============================================================
# MOA-Gateway-Pro 环境变量配置
# 复制此文件为 .env 并填入你的API keys
# ============================================================

# ---- 必需配置 ----
# 网关自身的API Key（用于外部调用本网关时的认证）
# 留空则服务器启动时自动生成
MOA_GATEWAY_KEY=

# 管理后台密码 (最少8位,生产环境必须强密码)
MOA_ADMIN_PASSWORD=

# ---- 免费LLM（至少配置1个，推荐全配）----
# Groq (免费, 速度快) - 获取: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (免费) - 获取: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek (极低成本) - 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# SiliconFlow (国内免费) - 获取: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# ---- 可选：增强能力 ----
# OpenAI (付费, 最强) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude ($5试用) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- 新增免费平台 ----
# Fireworks AI (免费$1试用) - https://fireworks.ai
FIREWORKS_API_KEY=

# AIML API (600+模型聚合) - https://aimlapi.com
AIMLAPI_API_KEY=

# Novita AI (多模态, $0.50注册) - https://novita.ai
NOVITA_API_KEY=

# ---- 可选：多模态 ----
# ElevenLabs (语音) - https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Tavily (搜索) - https://tavily.com/
TAVILY_API_KEY=

# ---- 可选：高级功能 ----
# Redis (缓存加速, 不配则用内存缓存)
REDIS_URL=

# PostgreSQL (生产数据库, 不配则用SQLite)
DATABASE_URL=
