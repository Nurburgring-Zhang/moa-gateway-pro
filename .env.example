# ============================================================
# MOA-Gateway-Pro 环境变量配置
# 复制此文件为 .env 并填入你的API keys
# ============================================================

# ---- 必需配置 ----
# 网关自身的API Key（用于外部调用本网关时的认证）
# 留空则服务器启动时自动生成
MOA_GATEWAY_KEY=

# 管理后台密码 (最少8位,生产环境必须强密码)
MOA_ADMIN_PASSWORD=

# ---- 免费LLM（至少配置1个，推荐全配）----
# Groq (免费, 速度快) - 获取: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (免费) - 获取: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek (极低成本) - 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# SiliconFlow (国内免费) - 获取: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# ---- 可选：增强能力 ----
# OpenAI (付费, 最强) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude ($5试用) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- 新增免费平台 ----
# Fireworks AI (免费$1试用) - https://fireworks.ai
FIREWORKS_API_KEY=

# AIML API (600+模型聚合) - https://aimlapi.com
AIMLAPI_API_KEY=

# Novita AI (多模态, $0.50注册) - https://novita.ai
NOVITA_API_KEY=

# ---- 可选：多模态 ----
# ElevenLabs (语音编辑/克隆/TTS: /v1/audio/edit, /v1/audio/clone, /v1/audio/speech)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Tavily (搜索) - https://tavily.com/
TAVILY_API_KEY=

# ---- 多模态生成：图像 ----
# 智谱 CogView (文生图 /v1/images/generations platform=cogview|zhipu)
# 获取: https://open.bigmodel.cn/
ZHIPU_API_KEY=
# 可选覆盖 CogView API 地址 (默认 https://open.bigmodel.cn/api/paas/v4)
ZHIPU_API_BASE=
COGVIEW_API_BASE=

# 阿里通义万相 (文生图 /v1/images/generations platform=wanx)
# WANX_API_KEY 缺省时回退 DASHSCOPE_API_KEY；获取: https://dashscope.console.aliyun.com/
WANX_API_KEY=
# 可选覆盖 (默认 https://dashscope.aliyuncs.com/api/v1)
WANX_API_BASE=

# OpenAI DALL-E (文生图 /v1/images/generations platform=openai；复用上面的 OPENAI_API_KEY)
# 图像编辑 /v1/images/edits、/v1/images/variations 同样使用 OPENAI_API_KEY
# 可选覆盖 OpenAI API 地址 (默认 https://api.openai.com)
OPENAI_API_BASE=

# Stable Diffusion WebUI (图像编辑 /v1/images/edits model=sd，本地自部署)
SD_API_BASE=
SD_API_KEY=

# ---- 多模态生成：视频 ----
# 快手可灵 Kling (文生视频 /v1/video/generations platform=kling 及 /v1/video/generate model=kling)
# 获取: https://klingai.kuaishou.com/
KLING_API_KEY=
# 可选覆盖 (默认 https://api.klingai.com/v1)
KLING_API_BASE=

# Runway Gen-3/4 (视频生成/编辑 /v1/video/generate, /v1/video/generations platform=runway)
# 获取: https://runwayml.com/
RUNWAY_API_KEY=
# 可选覆盖 (默认 https://api.runwayml.com/v1)
RUNWAY_API_BASE=

# ---- 多模态生成：音乐 ----
# MiniMax 音乐生成 (/v1/audio/music provider=minimax)
# 获取: https://platform.minimaxi.com/
MINIMAX_API_KEY=
# 可选覆盖 (默认 https://api.minimax.chat/v1)
MINIMAX_API_BASE=

# 昆仑万维天工 SkyMusic (/v1/audio/music provider=tiangong)
# 获取: https://platform.tiangong.cn/
TIANGONG_API_KEY=
# 可选覆盖 (默认 https://api.tiangong.cn/v1)
TIANGONG_API_BASE=

# ---- 多模态生成：3D ----
# Tripo3D (文/图生3D /v1/3d/generate) - 获取: https://www.tripo3d.ai/
TRIPO3D_API_KEY=
TRIPO3D_API_BASE=

# Meshy (文/图生3D /v1/3d/generate) - 获取: https://www.meshy.ai/
MESHY_API_KEY=
MESHY_API_BASE=

# ---- 语音识别 ASR (/v1/audio/transcriptions provider=openai|dashscope|iflytek) ----
# Whisper 兼容 ASR 专用 key (provider=openai；缺省回退 OPENAI_API_KEY)
WHISPER_API_KEY=
# 可选覆盖 Whisper 服务地址 (默认 https://api.openai.com/v1)
WHISPER_API_BASE=

# 阿里云 DashScope (paraformer ASR / sambert TTS / qwen 对话 / wanx 图像共用平台 key)
# 获取: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 可选覆盖 (默认 https://dashscope.aliyuncs.com)
DASHSCOPE_API_BASE=
# 专用音频 key（可选）：配置后 provider=auto 才会自动选 DashScope 音频服务
# （平台级 DASHSCOPE_API_KEY 需另行开通音频服务，故 auto 不直接用它）
DASHSCOPE_ASR_API_KEY=
DASHSCOPE_TTS_API_KEY=

# 科大讯飞星火 (ASR/TTS provider=iflytek) - 获取: https://xinghuo.xfyun.cn/
IFLYTEK_API_KEY=
# 可选覆盖 (默认 https://spark-api-open.xf-yun.com)
IFLYTEK_API_BASE=

# ---- 语音合成 TTS (/v1/audio/speech provider=openai|dashscope|iflytek) ----
# openai TTS 复用上面的 OPENAI_API_KEY；dashscope 复用 DASHSCOPE_API_KEY/DASHSCOPE_TTS_API_KEY；
# iflytek 复用 IFLYTEK_API_KEY。无 key 时按 mock.mode 降级：
# explicit=返回 200 并带 X-MOA-Mock 标注，disabled=直接 503。

# ---- 可选：高级功能 ----
# Redis (缓存加速, 不配则用内存缓存)
REDIS_URL=

# PostgreSQL (生产数据库, 不配则用SQLite)
DATABASE_URL=
