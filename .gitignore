# Temp scratch scripts (used during dev, not part of release)
# NOTE: anchored to repo root — unanchored '_*.py' also ignored every
# package '__init__.py' / '_helpers.py', breaking commits (B2 review H2).
/_*.py
/test_pat*.py
/debug_*.py
/dbg_*.py
/_dbg_*.py

# Any test_*.py anywhere — neither top-level nor capability/tests/
test_*.py
moa_gateway/capability/tests/

# All dev/debug/verify/fix/sim/diag scripts under scripts/
scripts/audit_*.py
scripts/check_*.py
scripts/debug_*.py
scripts/diag_*.py
scripts/fix_*.py
scripts/gen_*.py
scripts/list_*.py
scripts/patch_*.py
scripts/server_*.py
scripts/simulate_*.py
scripts/t.py
scripts/t[2-9].py
scripts/verify_*.py
scripts/deep_*.txt

# Loose top-level dev files
analyze_results.py
find_bare_except.py
start_test.py

# Test output captures
out_*.txt
out.txt
out20.txt
endpoints_scan.json
*.log

# 本地测试用 binary (Redis/Prometheus executable)
deploy/redis/
deploy/pg/
deploy/prometheus/
deploy/node_exporter/
deploy/*.zip
deploy/*.exe
deploy/*.dll
deploy/*.pdb
deploy/*.docx

# 临时 pip list 快照
_reqs.json
_reqs.txt

# bandit / pip_audit 中间输出
bandit_report.json
pip_audit_report.json

# test files (v1.8.1+ 严格清理:zip & repo 都不包含)
test_*.py
test_*.json
test_*.txt
test_*.log
**/test_*.py
# EXCEPTION (v3.2.1): moa_gateway/observability/test_report.py is a RUNTIME
# module (imported by server startup), not a test script. This ignore rule is
# exactly why the v3.1.1 release shipped without it and could not boot.
!moa_gateway/observability/test_report.py
**/test_*.json
**/test_*.txt
**/test_*.log
**/tests/
scripts/test_*.py
# test log files (mcp/bench etc)
test_*.err
test_*.log
bench_*.log

# Node / Next.js build artifacts
node_modules/
.next/
*.tsbuildinfo

# === Allow committed test suite ===
!tests/
!tests/*.py
!tests/conftest.py

# Audit and temporary reports
*_REPORT.md
*_REPORT.txt
AUDIT_*.txt
SCAN_REPORT.*

# Lint output
ruff_output.json

# Top-level dev scripts
analyze.py

# Error files
*.err
