 },
 "detectors": [
  {
   "type": "git-status",
   "category": "git",
   "commandPatterns": [
    {
     "source": "^git\\s+status\\b",
     "flags": "i"
    }
   ],
   "contentPatterns": [
    {
     "source": "^On branch ",
     "flags": "m"
    },
    {
     "source": "^Changes (?:not staged|to be committed)",
     "flags": "m"
    },
    {
     "source": "^Untracked files:",
     "flags": "m"
    }
   ]
  },
  {
   "type": "git-branch",
   "category": "git",
   "commandPatterns": [
    {
     "source": "^git\\s+branch\\b",
     "flags": "i"
    },
    {
     "source": "^git\\s+checkout\\b",
     "flags": "i"
    },
    {
     "source": "^git\\s+switch\\b",
     "flags": "i"
    }
   ],
   "contentPatterns": [
    {
     "source": "^\\*\\s+\\S+",
     "flags": "m"
    },
    {
     "source": "Switched to (?:a new )?branch",
     "flags": "i"
    },
    {
     "source": "Already on ['\"][^'\"]+['\"]",
     "flags": "i"
    }
   ]
  },
  {
   "type": "git-diff",
   "category": "git",
   "commandPatterns": [
    {
     "source": "^git\\s+diff\\b",
     "flags": "i"
    },
    {
     "source": "^git\\s+show\\b",
     "flags": "i"
    }
   ],
   "contentPatterns": [
    {
     "source": "^diff --git ",
     "flags": "m"
    },
    {
     "source": "^@@\\s+-\\d+,\\d+\\s+\\+\\d+,\\d+\\s+@@",
     "flags": "m"
    }
   ]
  },
  {
   "type": "git-log",
   "category": "git",
