    <!-- aggregator node -->
    <path android:pathData="M 44.3 71.8 a 9.7 9.7 0 1 0 19.4 0 a 9.7 9.7 0 1 0 -19.4 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44.3"
                android:startY="62.1"
                android:endX="63.7"
                android:endY="81.5">
                <item android:offset="0" android:color="#FF6366F1" />
                <item android:offset="1" android:color="#FF22D3EE" />
            </gradient>
